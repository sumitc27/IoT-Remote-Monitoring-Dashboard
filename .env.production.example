# ====================================
# IoT Remote Monitoring Dashboard — Production Environment Variables
# ====================================

# --- App ---
APP_NAME=IoT Remote Monitoring Dashboard
APP_VERSION=1.0.0
DEBUG=false

# --- Database (PostgreSQL + TimescaleDB) ---
DATABASE_URL=postgresql+asyncpg://iotdash:super_secret_db_password@timescaledb:5432/iotdash_db
POSTGRES_USER=iotdash
POSTGRES_PASSWORD=super_secret_db_password
POSTGRES_DB=iotdash_db

# --- MQTT (EMQX) ---
MQTT_BROKER_HOST=j18eff7a.ala.asia-southeast1.emqxsl.com
MQTT_BROKER_PORT=8883
MQTT_USERNAME=prod_user
MQTT_PASSWORD=prod_pass
MQTT_TOPIC_PATTERN=test/devices/+/power
MQTT_USE_TLS=true

# --- JWT Authentication ---
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
CORS_ORIGINS=["http://localhost", "https://yourdomain.com"]
