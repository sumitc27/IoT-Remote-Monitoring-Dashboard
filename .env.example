# ====================================
# IoT Remote Monitoring Dashboard — Environment
# ====================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- App ---
APP_NAME=IoT Remote Monitoring Dashboard
APP_VERSION=0.1.0
DEBUG=true

# --- Database (PostgreSQL + TimescaleDB) ---
DATABASE_URL=postgresql+asyncpg://iotdash:iotdash_dev@localhost:5432/iotdash_db
POSTGRES_USER=iotdash
POSTGRES_PASSWORD=iotdash_dev
POSTGRES_DB=iotdash_db

# --- MQTT (EMQX) ---
MQTT_BROKER_HOST=j18eff7a.ala.asia-southeast1.emqxsl.com
MQTT_BROKER_PORT=8883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
MQTT_TOPIC_PATTERN=test/devices/+/power
MQTT_USE_TLS=true

# --- JWT Authentication ---
JWT_SECRET_KEY=generate-a-strong-random-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
